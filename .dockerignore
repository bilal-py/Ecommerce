# Ignore user & IDE files
**/.classpath
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/*.*proj.user
*.suo
*.user
*.log
*.sqlite
*.secrets.json

# Ignore git and docker tooling
**/.git
**/.gitignore
**/.dockerignore
docker-compose.yml
docker-compose.override.yml

# Ignore build output
**/bin/
**/obj/

# Ignore Kubernetes or Azure Dev files
**/azds.yaml
**/charts/
**/secrets.dev.yaml
**/values.dev.yaml

# Ignore frontend files (optional)
**/node_modules/
**/npm-debug.log

# Ignore local environment secrets
.env
.env.*
appsettings.Development.json

# ✅ BUT DON'T IGNORE PROJECT FILES
!Ecommerce/
!Ecommerce/Ecommerce.csproj
