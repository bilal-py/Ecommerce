@model Ecommerce.Models.EmailLog

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>EmailLog</h4>
<hr />

<div class="container-fluid">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;background: linear-gradient(to right, #1f1f2e, #29293d, #3a2b4f);">
        <div class="col-md-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-white"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group">
                    <label asp-for="ToEmail" class="control-label text-white"></label>
                    <input asp-for="ToEmail" class="form-control" />
                    <span asp-validation-for="ToEmail" class="text-white"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Cc" class="control-label  text-white"></label>
                    <input asp-for="Cc" class="form-control" />
                    <span asp-validation-for="Cc" class="text-white"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Subject" class="control-label text-white"></label>
                    <input asp-for="Subject" class="form-control" />
                    <span asp-validation-for="Subject" class="text-white"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Body" class="control-label text-white"></label>
                    <input asp-for="Body" class="form-control" />
                    <span asp-validation-for="Body" class="text-white"></span>
                </div>
                <div class="form-group form-check text-white">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="EmailSent" /> @Html.DisplayNameFor(model => model.EmailSent)
                    </label>
                </div>
                <div class="form-group">
                    <label asp-for="CreatedAt" class="control-label text-white"></label>
                    <input asp-for="CreatedAt" class="form-control" />
                    <span asp-validation-for="CreatedAt" class="text-white"></span>
                </div>
                <div class="form-group">
                    <label asp-for="WarrantyId" class="control-label text-white"></label>
                    <input asp-for="WarrantyId" class="form-control" />
                    <span asp-validation-for="WarrantyId" class="text-white"></span>
                </div>
               
                <div class="d-flex justify-content-between">
                   
                    <div class="form-group  text-center mt-3">
                        <input type="submit" value="Save" class="btn btn-primary" style="background-color: #6d36e4;" />
                    </div>
                   
                    <div class=" align-items-center mt-3">
                        <a asp-action="Index" class="btn btn-secondary m-2" style=" background-color: #6d36e4;">All Emails Logs</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


