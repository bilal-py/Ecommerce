@model Ecommerce.Models.RegisteredRollNumbers

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="col-md-6">
            <div class="p-4" style="background-color: #6d36e4; border-radius: 8px; color: white; text-align: center;">
                <h1 class="my-h1">Register Roll Number</h1>
            </div>
            <div class="p-4 mt-3" style="background-color: #fff; border-radius: 8px; box-shadow: 0px 0px 10px 0px rgba(0,0,0,0.2);">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mt-3">
                        <label asp-for="RollNumber" class="control-label"></label>
                        <input asp-for="RollNumber" class="form-control" />
                        <span asp-validation-for="RollNumber" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-3">
                        <label asp-for="Category" class="control-label"></label>
                        <input asp-for="Category" class="form-control" />
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                    <div class="form-group mt-3">
                        <label asp-for="RegistrationDate" class="control-label"></label>
                        <input asp-for="RegistrationDate" class="form-control" />
                        <span asp-validation-for="RegistrationDate" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-3">
                        <label asp-for="Status" class="control-label"></label>
                        <input asp-for="Status" class="form-control" />
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3 text-center mt-3">
                        <input type="submit" value="Create" class="btn btn-primary" style="background-color: #6d36e4;" />
                    </div>
                    <div class=" align-items-left mt-3">
                        <a asp-action="Index" class="btn btn-secondary" style=" background-color: #6d36e4;">Back to List</a>
                    </div>
                </form>
                              
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
