@model IEnumerable<Ecommerce.Models.Warranty>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RollNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarrantyStartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WarrantyEndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleYear)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleMake)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleModel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleVIN)
            </th>
           
            <th>
                @Html.DisplayNameFor(model => model.Customer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Dealer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BumpersFront)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HoodLead)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mirrors)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BumpersBack)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EdgeGuard)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Windshield)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FendersLead)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoofFull)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HoodFull)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RoofLead)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Headlamps)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Trunk)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.RollNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Status)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WarrantyStartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WarrantyEndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehicleYear)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehicleMake)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehicleModel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VehicleVIN)
            </td>
           
            <td>
                @Html.DisplayFor(modelItem => item.Customer.CustomerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Dealer.DealerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BumpersFront)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HoodLead)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mirrors)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BumpersBack)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EdgeGuard)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Windshield)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FendersLead)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RoofFull)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HoodFull)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RoofLead)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Headlamps)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Trunk)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.WarrantyId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.WarrantyId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.WarrantyId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
