
@model List<Ecommerce.Models.Warranty>
@{
    ViewData["Title"] = "WarrantyExpiredPage";
    var isAdmin = User.IsInRole("Admin");
}
@{
    var categoryNames = new Dictionary<string, string>
    {
        { "A", "Prime" },
        { "B", "Ultimate" },
        { "C", "Ultimate Plus" }
    };
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 40vh;">
    <div class="">
        <h3 class="mb-4 text-center text-white">Warranty Expired</h3>

        <table class="table table-bordered table-hover text-center">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Dealer</th>
                    <th>Vehicle Year</th>
                    <th>Vehicle Make</th>
                    <th>Vehicle Model</th>
                    <th>Warranty Start Date</th>
                    <th>Roll Number</th>
                    <th>Warranty Period</th>
                    <th>Status</th>
                    @if (isAdmin)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                
            </tbody>
        </table>
    </div>
</div>
