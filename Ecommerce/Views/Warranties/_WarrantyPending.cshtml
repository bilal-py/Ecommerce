
@model List<Ecommerce.Models.Warranty>
@{
    ViewData["Title"] = "WarrantyPendingPage";
    var isAdmin = User.IsInRole("Admin");
}
@{
    var categoryNames = new Dictionary<string, string>
    {
        { "A", "Prime" },
        { "B", "Ultimate" },
        { "C", "Ultimate Plus" }
    };
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 40vh;">
    <div class="table-responsive">
        <h3 class="mb-4 text-center text-white">Warranty Pending</h3>

        <table class="table table-bordered table-hover text-center">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Dealer</th>
                    <th>Vehicle Year</th>
                    <th>Vehicle Make</th>
                    <th>Vehicle Model</th>
                    <th>Warranty Start Date</th>
                    <th>Roll Number</th>
                    <th>Warranty Period</th>
                    <th>Status</th>
                    @if (isAdmin)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@item.Customer?.CustomerName</td>
                        <td>@item.Customer?.Email</td>
                        <td>@item.Customer?.PhoneNumber</td>
                        <td>@item.Dealer?.DealerName</td>
                        <td>@item.VehicleYear</td>
                        <td>@item.VehicleMake</td>
                        <td>@item.VehicleModel</td>
                        <td>@item.WarrantyStartDate</td>
                        <td>@item.RollNumber</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.RegisteredRollNumber?.Category) && categoryNames.TryGetValue(item.RegisteredRollNumber.Category, out var friendlyName))
                            {
                                @friendlyName
                            }
                        </td>


                        <td>Pending</td>

                        @if (isAdmin)
                        {
                            <td>
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="warrantyId" value="@item.WarrantyId" />
                                    <input type="hidden" name="status" value="1" />
                                    <button class="btn btn-success btn-sm px-3">Accept</button>
                                </form>
                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                    <input type="hidden" name="warrantyId" value="@item.WarrantyId" />
                                    <input type="hidden" name="status" value="2" />
                                    <button class="btn btn-danger btn-sm px-3">Reject</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>