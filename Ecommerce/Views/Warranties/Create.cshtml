@model Ecommerce.Models.Warranty

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Warranty</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="RollNumber" class="control-label"></label>
                <input asp-for="RollNumber" class="form-control" />
                <span asp-validation-for="RollNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WarrantyStartDate" class="control-label"></label>
                <input asp-for="WarrantyStartDate" class="form-control" />
                <span asp-validation-for="WarrantyStartDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WarrantyEndDate" class="control-label"></label>
                <input asp-for="WarrantyEndDate" class="form-control" />
                <span asp-validation-for="WarrantyEndDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VehicleYear" class="control-label"></label>
                <input asp-for="VehicleYear" class="form-control" />
                <span asp-validation-for="VehicleYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VehicleMake" class="control-label"></label>
                <input asp-for="VehicleMake" class="form-control" />
                <span asp-validation-for="VehicleMake" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VehicleModel" class="control-label"></label>
                <input asp-for="VehicleModel" class="form-control" />
                <span asp-validation-for="VehicleModel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="VehicleVIN" class="control-label"></label>
                <input asp-for="VehicleVIN" class="form-control" />
                <span asp-validation-for="VehicleVIN" class="text-danger"></span>
            </div>
          
            <div class="form-group">
                <label asp-for="CustomerId" class="control-label"></label>
                <select asp-for="CustomerId" class ="form-control" asp-items="ViewBag.CustomerId"></select>
            </div>
            <div class="form-group">
                <label asp-for="DealerId" class="control-label"></label>
                <select asp-for="DealerId" class ="form-control" asp-items="ViewBag.DealerId"></select>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="BumpersFront" /> @Html.DisplayNameFor(model => model.BumpersFront)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="HoodLead" /> @Html.DisplayNameFor(model => model.HoodLead)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Mirrors" /> @Html.DisplayNameFor(model => model.Mirrors)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="BumpersBack" /> @Html.DisplayNameFor(model => model.BumpersBack)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="EdgeGuard" /> @Html.DisplayNameFor(model => model.EdgeGuard)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Windshield" /> @Html.DisplayNameFor(model => model.Windshield)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="FendersLead" /> @Html.DisplayNameFor(model => model.FendersLead)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="RoofFull" /> @Html.DisplayNameFor(model => model.RoofFull)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="HoodFull" /> @Html.DisplayNameFor(model => model.HoodFull)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="RoofLead" /> @Html.DisplayNameFor(model => model.RoofLead)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Headlamps" /> @Html.DisplayNameFor(model => model.Headlamps)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Trunk" /> @Html.DisplayNameFor(model => model.Trunk)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

