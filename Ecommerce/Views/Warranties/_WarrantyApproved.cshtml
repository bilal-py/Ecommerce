@model List<Ecommerce.Models.Warranty>
@{
    ViewData["Title"] = "WarrantyApprovedPage";
}
@{
    var categoryNames = new Dictionary<string, string>
    {
        { "A", "Prime" },
        { "B", "Ultimate" },
        { "C", "Ultimate Plus" }
    };
}


<div class="container d-flex justify-content-center align-items-center" style="min-height: 40vh;">
    <div class="col-md-10 table-responsive">
        <h3 class="mb-4 text-center text-white">Warranty Approved</h3>
        <table class="table table-bordered table-hover text-center">
            <thead class="table-primary">
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Dealer</th>
                    <th>Vehicle Year</th>
                    <th>Vehicle Make</th>
                    <th>Vehicle Model</th>
                    <th>Warranty Start Date</th>
                    <th>Roll Number</th>
                    <th>Warranty Period</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@item.Customer?.CustomerName</td>
                        <td>@item.Customer?.Email</td>
                        <td>@item.Customer?.PhoneNumber</td>
                        <td>@item.Dealer?.DealerName</td>
                        <td>@item.VehicleYear</td>
                        <td>@item.VehicleMake</td>
                        <td>@item.VehicleModel</td>
                        <td>@item.WarrantyStartDate</td>
                        <td>@item.RollNumber</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.RegisteredRollNumber?.Category) && categoryNames.TryGetValue(item.RegisteredRollNumber.Category, out var friendlyName))
                            {
                                @friendlyName
                            }
                        </td>

                        <td>Approved</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
