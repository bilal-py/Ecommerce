<!DOCTYPE html>
<style>
    header {
        background: #212529; /* dark grey to white */
    }  

    .logo-border {
        display: inline-block;
        padding: 10px 20px;
        border: 2px solid white;
        border-radius: 25px;
        color: white;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.3s ease;
    }

       /*  .logo-border:hover {
            background-color: white;
            color: #000 !important;
        } */

    html {
        scroll-behavior: smooth;
    }
</style>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>MotoProtekt</title>
    <meta content="" name="description">
    <meta content="" name="keywords">

    <!-- Favicons -->
    <link href="~/assets/img/logo_min.png" rel="icon">
@*     <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon"> *@

    <link rel="icon" type="image/x-icon" href="~/assets/img/logo_min.png" />

    <!-- Font Awesome -->
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css?family=Varela+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet" />

    <!-- Vendor CSS Files -->
    <link href="~/assets/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/assets/vendor/aos/aos.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet" asp-append-version="true">
    <link href="~/assets/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet" asp-append-version="true">

    <!-- Main CSS File -->
    <link href="~/assets/assets/css/main.css" rel="stylesheet">

    <script>
        document.addEventListener("DOMContentLoaded", function () {
          const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
          const navbarCollapse = document.getElementById('navbarResponsive');

          navLinks.forEach(function (link) {
            link.addEventListener('click', function () {
              const collapse = bootstrap.Collapse.getInstance(navbarCollapse) ||
                               new bootstrap.Collapse(navbarCollapse, { toggle: false });
              collapse.hide();
            });
          });
        });
    </script>


    <!-- Simple Custom CSS -->
    <style>
        /* Navbar background */
        #mainNav {
            background-color: #212529;
            padding: 15px 0;
        }

        /* Toggler button styling */
        .navbar-toggler {
            color: white;
            border: 1px solid rgba(255,255,255,0.5);
        }

        /* Mobile menu styling */
        .navbar-collapse {
            background-color: #212529;
            padding: 15px;
            margin-top: 10px;
        }

        /* Ensure links are visible */
        .navbar-nav .nav-link {
            color: white !important;
            padding: 10px 15px;
        }

        .logo {
            height: 40px; /* adjust as needed */
        }
    </style>
</head>

<body id="page-top">
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="mainNav">
        <div class="container">
            <a class="navbar-brand logo-border" asp-controller="Home" asp-action="Index">
                <img src="~/image/moto_logo.png" class="logo" alt="MotoProtekt Logo" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-end" id="navbarResponsive">
                <ul class="navbar-nav ms-auto text-uppercase fw-bol">
                   @*  <li class="nav-item">
                        <a class="nav-link active" asp-controller="Home" asp-action="Index">Home</a>
                    </li> *@

                    @if (User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Admin"))
                        {

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="EmailLogs" asp-action="PendingEmailList">Email Logs</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="RegisteredRollNumbers" asp-action="Create">Register Roll Number</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Warranties" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="UserProfile">Show Profile</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                       @*  <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="CreateAccount">Create Account</a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login" data-bs-toggle="tooltip"
                               data-bs-placement="bottom"
                               title="Login / My Account"><i class="bi bi-person"></i></a>
                        </li>
                       
                      @*   <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="AboutUs">About us</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#contact">Contact</a>
                        </li> *@
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    @* <main id="main" class=" py-5" style="background:linear-gradient(to right, #1f1f2e, #29293d, #3a2b4f);"> *@
    <main id="main" class=" py-5" style="background:#1b1b1b">
        @RenderBody()
    </main>


    <!-- Footer -->
 
    <!-- Footer -->

    
    <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
    @* <div id="preloader"></div> *@
   

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener('DOMContentLoaded', function () {
          var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
          tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
          });
        });
    </script>
</body>
</html>

