@model Ecommerce.Models.LoginModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Page‑specific styles -->
<style>
    /* full‑page gradient like the screenshot */
    body.login-gradient-bg {
        background: linear-gradient(to right, #1f1f2e, #29293d, #3a2b4f);
    }


    .auth-card {
        backdrop-filter: blur(40px);
        border-radius: 30px;
        overflow: hidden;
    }

        .auth-card .left-pane {
            background: rgba(0, 0, 0, 0.75);
            color: #fff;
        }

        .auth-card .right-pane {
            background: #000;
            color: #fff;
            position: relative;
        }

        .auth-card .form-control-dark {
            background: #000;
            border: none;
            border-radius: 9999px;
            color: #fff;
            padding: 0.9rem 1.5rem;
        }

            .auth-card .form-control-dark::placeholder {
                color: #aaa;
            }

    .gradient-btn {
        background: linear-gradient(90deg, #ff8ca5, #ffa897);
        border: none;
        color: #000;
        font-weight: 600;
        border-radius: 9999px;
        width: 100%;
        padding: 0.7rem 1rem;
    }

    /* “get your right job” floating card on testimonial side */
    .floating-card {
        position: absolute;
        bottom: 1.5rem;
        right: 1.5rem;
        background: rgba(255, 255, 255, 0.25);
        backdrop-filter: blur(12px);
        padding: 1rem;
        border-radius: 20px;
        max-width: 260px;
        font-size: 0.85rem;
    }
</style>

<body class="login-gradient-bg" style="padding-top: 80px;">
    <div class="d-flex justify-content-center align-items-center py-5">
        <div class="auth-card shadow-lg w-100" style="max-width: 1050px;">

            <!-- LEFT: Login pane -->
            <div class="left-pane p-5 col-12 col-md-6">
                <h2 class="fw-bold display-6 mb-1">Welcome back</h2>
                <p class="text-muted mb-4" style="color:#c9c9c9!important;">Please enter your account details</p>

                <form asp-action="Login" method="post">
                    @Html.HiddenFor(m => m.ReturnUrl)
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    @if (ViewBag.Message != null)
                    {
                        <span class="text-danger">@ViewBag.Message</span>
                    }

                    <!-- Email -->
                    <div class="mb-3 text-start">
                        <label for="userName" class="form-label">Username:</label>
                        <input class="form-control" type="text" name="userName" placeholder="userName" />
                        <span asp-validation-for="userName" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3 text-white">
                        <label for="Password" class="form-label">Password:</label>
                        <input class="form-control" type="password" name="password" placeholder="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Keep me logged in & Forgot -->
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe" />
                            <label class="form-check-label small" for="rememberMe">Keep me logged in</label>
                        </div>
                        <a href="#" class="small link-light text-decoration-underline">Forgot password</a>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="gradient-btn mb-4">Sign in</button>

                    <!-- Social icons -->
                   @*  <div class="d-flex justify-content-center gap-3">
                        <a href="#"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" width="32" height="32" /></a>
                        <a href="#"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" width="32" height="32" /></a>
                        <a href="#"><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/facebook/facebook-original.svg" width="32" height="32" /></a>
                    </div> *@
                </form>
            </div>

            <!-- RIGHT: Testimonial pane -->

        </div>
    </div>
</body>
