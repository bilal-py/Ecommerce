@model Ecommerce.Models.RegisterModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid" style="background:#1b1b1b">
    <div class="row justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="col-md-6" style=" margin-top:50px;">
            <div class="p-4" style="background:style="background: linear-gradient(to right, #1f1f2e, #29293d, #3a2b4f);">
                <h1 class="my-h1 text-white">Create Account</h1>
            </div>
            <div class="p-4 mt-3" style="background:style="background: linear-gradient(to right, #1f1f2e, #29293d, #3a2b4f);">
                <form asp-action="CreateAccount" method="post">
                    @* <div asp-validation-summary="All" class="text-danger"></div>*@
                    <div class="mb-3 text-white">
                        <label for="Email" class="form-label">Email:</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-white">
                        <label for="UserName" class="form-label">Username:</label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-white">
                        <label for="Password" class="form-label">Password:</label>
                        <input asp-for="Password" type="password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-white">
                        <label for="ConfirmPassword" class="form-label">Confirm Password:</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-white">
                        <label for="Age" class="form-label">Age:</label>
                        <input asp-for="Age" class="form-control" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-white">
                        <label for="Contact" class="form-label">Contact Number:</label>
                        <input asp-for="Contact" class="form-control" />
                        <span asp-validation-for="Contact" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-white">
                        <label for="Address" class="form-label">Address:</label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-white">
                        <label for="FirmName" class="form-label">Firm Name:</label>
                        <input asp-for="FirmName" class="form-control" />
                        <span asp-validation-for="FirmName" class="text-danger"></span>
                    </div>

                    <div class="mb-3 text-white">
                        <label for="GSTNumber" class="form-label">GSTNumber:</label>
                        <input asp-for="GSTNumber" class="form-control" />
                        <span asp-validation-for="GSTNumber" class="text-danger"></span>
                    </div>

                    <div style="text-align: center;">
                        <button type="submit" class="btn btn-primary">Register</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
